{
  "hosting": {
    "public": ".",
    "ignore": [
      "**/.*",
      "firebase.json",
      "firestore.rules",
      "README.md",
      "tools/**",
      ".git/**",
      "**/.git/**"
    ],
    "headers": [
      {
        "source": "**/*.@(jpg|png)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=604800"
          }
        ]
      },
      {
        "source": "/sw.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/firebase-config.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ],
    "site": "gglog"
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}
